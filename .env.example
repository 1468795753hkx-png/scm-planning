# 数据库连接（本地 MVP 用 SQLite；生产切换 PostgreSQL）
DATABASE_URL=sqlite:///./scm.db
# DATABASE_URL=postgresql+psycopg://scm:change-me@localhost:5432/scm

# JWT 密钥（生产务必更换为强随机值）
SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS 白名单（逗号分隔，生产填真实前端域名）
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080